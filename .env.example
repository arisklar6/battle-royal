# Battle Royal — local secrets. Copy to `.env` and fill in. `.env` is gitignored.
# This repo is PUBLIC — never commit a real key.

# Google Gemini API key, used only by the art pipeline in tools/art/ to generate
# sprite art ("nano banana"). Get one at https://aistudio.google.com/apikey
# Nothing in the game server or the shipped Docker image reads this.
GEMINI_API_KEY=
